{
  "version": 1,
  "schemas": {
    "LoginRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "email",
        "password"
      ],
      "additionalProperties": false
    },
    "EmptyAuthMutation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "SessionIdentity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "employee",
            "clinic"
          ]
        }
      },
      "required": [
        "account_id",
        "profile"
      ],
      "additionalProperties": false
    },
    "ObjectId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "enum": [
        "pending",
        "correction_requested",
        "rejected",
        "accepted",
        "manufacturing",
        "completed",
        "delivered",
        "cancelled"
      ]
    },
    "Patient": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string",
          "minLength": 1
        },
        "last_name": {
          "type": "string",
          "minLength": 1
        },
        "internal_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Tooth": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fdi": {
          "type": "number",
          "enum": [
            11,
            12,
            13,
            14,
            15,
            16,
            17,
            18,
            21,
            22,
            23,
            24,
            25,
            26,
            27,
            28,
            31,
            32,
            33,
            34,
            35,
            36,
            37,
            38,
            41,
            42,
            43,
            44,
            45,
            46,
            47,
            48
          ]
        },
        "selection": {
          "type": "string",
          "enum": [
            "normal",
            "pontic"
          ]
        }
      },
      "required": [
        "fdi",
        "selection"
      ],
      "additionalProperties": false
    },
    "ClinicSubmission": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "patient": {
          "type": "object",
          "properties": {
            "first_name": {
              "type": "string",
              "minLength": 1
            },
            "last_name": {
              "type": "string",
              "minLength": 1
            },
            "internal_reference": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "requested_delivery_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "material_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "shade_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "work_type_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "teeth": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fdi": {
                "type": "number",
                "enum": [
                  11,
                  12,
                  13,
                  14,
                  15,
                  16,
                  17,
                  18,
                  21,
                  22,
                  23,
                  24,
                  25,
                  26,
                  27,
                  28,
                  31,
                  32,
                  33,
                  34,
                  35,
                  36,
                  37,
                  38,
                  41,
                  42,
                  43,
                  44,
                  45,
                  46,
                  47,
                  48
                ]
              },
              "selection": {
                "type": "string",
                "enum": [
                  "normal",
                  "pontic"
                ]
              }
            },
            "required": [
              "fdi",
              "selection"
            ],
            "additionalProperties": false
          }
        },
        "file_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "patient",
        "requested_delivery_date",
        "material_id",
        "shade_id",
        "teeth",
        "file_ids"
      ],
      "additionalProperties": false
    },
    "MutationPrecondition": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^\\/api\\/v1\\/problems\\/[a-z_]+$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "AUTHENTICATION_REQUIRED",
            "FORBIDDEN",
            "RESOURCE_NOT_FOUND",
            "REVISION_CONFLICT",
            "STATE_CONFLICT",
            "REQUEST_ALREADY_PENDING",
            "CATALOG_FORBIDDEN",
            "CATALOG_UNAVAILABLE",
            "FILE_NOT_READY",
            "FILE_TOO_LARGE",
            "UPLOAD_EXPIRED",
            "IDEMPOTENCY_CONFLICT",
            "RATE_LIMITED",
            "MAINTENANCE",
            "STORAGE_UNAVAILABLE",
            "DEPENDENCY_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^\\/"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              }
            },
            "required": [
              "pointer",
              "code"
            ],
            "additionalProperties": false
          }
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "request_id"
      ],
      "additionalProperties": false
    },
    "LogisticsProjection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "clinic_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "correction_requested",
            "rejected",
            "accepted",
            "manufacturing",
            "completed",
            "delivered",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priority": {
          "type": "boolean"
        },
        "requested_delivery_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_delivery_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "laboratory_delivery",
                "clinic_pickup",
                "external_courier"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "number",
        "clinic_name",
        "status",
        "revision",
        "priority",
        "requested_delivery_date",
        "planned_delivery_date",
        "delivery_mode"
      ],
      "additionalProperties": false
    },
    "SubmissionReceipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "order_id",
        "number",
        "committed_at",
        "revision"
      ],
      "additionalProperties": false
    },
    "Health": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ok"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "ClinicContactFields": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "name",
        "dentist_first_name",
        "dentist_last_name",
        "phone",
        "address"
      ],
      "additionalProperties": false
    },
    "ClinicContactUpdate": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "expected_revision",
        "name",
        "dentist_first_name",
        "dentist_last_name",
        "phone",
        "address"
      ],
      "additionalProperties": false
    },
    "ClinicProfile": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "dentist_first_name",
        "dentist_last_name",
        "phone",
        "address"
      ],
      "additionalProperties": false
    },
    "ClinicRegistrationRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dentist_last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "accepted_terms": {
          "type": "boolean",
          "const": true
        },
        "terms_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "name",
        "dentist_first_name",
        "dentist_last_name",
        "phone",
        "address",
        "email",
        "password",
        "accepted_terms",
        "terms_version_id"
      ],
      "additionalProperties": false
    },
    "ClinicRegistrationReceipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "pending"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
