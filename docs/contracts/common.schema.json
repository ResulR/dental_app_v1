{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dental lab API v1 — shared design contracts",
  "description": "Design only; schemas are not deployed routes or database columns.",
  "$defs": {
    "ObjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Status": {
      "type": "string",
      "enum": [
        "pending",
        "correction_requested",
        "rejected",
        "accepted",
        "manufacturing",
        "completed",
        "delivered",
        "cancelled"
      ]
    },
    "Patient": {
      "type": "object",
      "properties": {
        "first_name": {
          "type": "string",
          "minLength": 1
        },
        "last_name": {
          "type": "string",
          "minLength": 1
        },
        "internal_reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "first_name",
            "last_name"
          ]
        },
        {
          "required": [
            "internal_reference"
          ]
        }
      ]
    },
    "Tooth": {
      "type": "object",
      "properties": {
        "fdi": {
          "type": "integer",
          "enum": [
            11,
            12,
            13,
            14,
            15,
            16,
            17,
            18,
            21,
            22,
            23,
            24,
            25,
            26,
            27,
            28,
            31,
            32,
            33,
            34,
            35,
            36,
            37,
            38,
            41,
            42,
            43,
            44,
            45,
            46,
            47,
            48
          ]
        },
        "selection": {
          "enum": [
            "normal",
            "pontic"
          ]
        }
      },
      "required": [
        "fdi",
        "selection"
      ],
      "additionalProperties": false
    },
    "ClinicSubmission": {
      "type": "object",
      "properties": {
        "patient": {
          "$ref": "#/$defs/Patient"
        },
        "requested_delivery_date": {
          "type": "string",
          "format": "date"
        },
        "material_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "shade_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "work_type_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "description": {
          "type": "string"
        },
        "teeth": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tooth"
          },
          "uniqueItems": true,
          "maxItems": 32
        },
        "file_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectId"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "patient",
        "requested_delivery_date",
        "material_id",
        "shade_id",
        "teeth",
        "file_ids"
      ],
      "additionalProperties": false
    },
    "MutationPrecondition": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^/api/v1/problems/[a-z_]+$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "enum": [
            "VALIDATION_FAILED",
            "AUTHENTICATION_REQUIRED",
            "FORBIDDEN",
            "RESOURCE_NOT_FOUND",
            "REVISION_CONFLICT",
            "STATE_CONFLICT",
            "REQUEST_ALREADY_PENDING",
            "CATALOG_FORBIDDEN",
            "CATALOG_UNAVAILABLE",
            "FILE_NOT_READY",
            "FILE_TOO_LARGE",
            "UPLOAD_EXPIRED",
            "IDEMPOTENCY_CONFLICT",
            "RATE_LIMITED",
            "MAINTENANCE",
            "STORAGE_UNAVAILABLE",
            "DEPENDENCY_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              }
            },
            "required": [
              "pointer",
              "code"
            ],
            "additionalProperties": false
          }
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "request_id"
      ],
      "additionalProperties": false
    },
    "LogisticsProjection": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "clinic_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "priority": {
          "type": "boolean"
        },
        "requested_delivery_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "planned_delivery_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "delivery_mode": {
          "enum": [
            "laboratory_delivery",
            "clinic_pickup",
            "external_courier",
            null
          ]
        }
      },
      "required": [
        "id",
        "number",
        "clinic_name",
        "status",
        "revision",
        "priority",
        "requested_delivery_date",
        "planned_delivery_date",
        "delivery_mode"
      ],
      "additionalProperties": false
    },
    "SubmissionReceipt": {
      "type": "object",
      "properties": {
        "order_id": {
          "$ref": "#/$defs/ObjectId"
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "order_id",
        "number",
        "committed_at",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
