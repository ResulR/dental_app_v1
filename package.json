{
  "name": "dental-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "check:versioning": "python3 scripts/check-versioning.py",
    "check:workspace": "python3 scripts/run-quality.py check:workspace",
    "typecheck": "python3 scripts/run-quality.py typecheck",
    "build:packages": "python3 scripts/run-quality.py build:packages",
    "lint": "python3 scripts/run-quality.py lint",
    "format": "python3 scripts/run-quality.py format",
    "format:check": "python3 scripts/run-quality.py format:check",
    "check:boundaries": "python3 scripts/run-quality.py check:boundaries",
    "quality": "python3 scripts/run-quality.py quality",
    "test:unit": "python3 scripts/run-quality.py test:unit",
    "test:integration": "python3 scripts/run-quality.py test:integration",
    "test:e2e-api": "python3 scripts/run-quality.py test:e2e-api",
    "build:web": "python3 scripts/run-quality.py build:web",
    "check:contracts": "python3 scripts/run-quality.py check:contracts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
