# Exemple SANS SECRET, incomplet et non utilisable pour le runtime.
# Valeurs publiques constatées ; identité runtime à approuver séparément.
# Ne pas utiliser dental-ai (audit) ou dental-migrate pour l'application.
# Validation obligatoire au démarrage à implémenter avec le backend.
PGDATABASE=dental_lab
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=
PGPASSWORD=
