# Exemple SANS SECRET. Aucun fichier réel ni service n'est configuré ici.
# Client peer reçu en 6.1, identité Linux runtime requise ; jamais dental-ai.
PGDATABASE=dental_lab
PGHOST=/var/run/postgresql
PGPORT=5432
PGUSER=dental-lab-runtime
# Ne pas définir PGPASSWORD, PGOPTIONS, PGSERVICE ou d'autres variables PG.
# Port loopback explicitement alloué par l'administrateur :
# NODE_ENV=production
# DENTAL_LAB_PORT=<port_approuvé>
DENTAL_LAB_AUTH_ENABLED=false
# Activer seulement après réception schéma/grants et configuration approuvée.
# Valeurs publiques à choisir ; exemples non opérationnels :
# DENTAL_LAB_AUTH_ENABLED=true
# DENTAL_LAB_ORIGIN=https://<domaine_approuvé>
# DENTAL_LAB_SESSION_LIFETIME_MS=<durée_approuvée>
# DENTAL_LAB_SESSION_ABSOLUTE_MS=<borne_approuvée>
# DENTAL_LAB_LOGIN_WINDOW_MS=<fenêtre_approuvée>
# DENTAL_LAB_LOGIN_ACCOUNT_ATTEMPTS=<limite_approuvée>
# DENTAL_LAB_LOGIN_NETWORK_ATTEMPTS=<limite_approuvée>
# DENTAL_LAB_LOGIN_MAX_KEYS=<capacité_approuvée>
# Voir docs/AUTH_API.md ; aucun fallback au limiteur mémoire dans le runtime.
